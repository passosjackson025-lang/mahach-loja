# Copie para .env e coloque seus próprios valores. NUNCA publique este arquivo.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# API Vendizap: Configurar > Integrações > API Pública
# VENDIZAP_ID=
# VENDIZAP_SECRET=
# Melhor Envio: cotação apenas (não emite etiquetas)
# ORIGIN_CEP=00000000
# MELHOR_ENVIO_TOKEN=
# SHIPPING_CONTACT_EMAIL=
# MELHOR_ENVIO_SANDBOX=true
# Bling: conexão OAuth 2.0 futura; NÃO habilita envio de pedidos automaticamente.
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=
# BLING_REDIRECT_URI=
# BLING_TOKEN_ENCRYPTION_KEY=
# Mercado Pago: não habilita pagamento até integração server-side e webhooks homologados.
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# Pesquisa de imagens: SERPAPI_KEY é utilizada apenas pelo script Python, via variável de ambiente.
# V5: também configuráveis pelo painel, em Integrações.
# WHATSAPP=5511995209827
# SHOP_ADDRESS=Rua, número, bairro, cidade/UF
# Para hospedagem com vários ambientes, defina uma chave AES-256 estável
# MAHACH_SETTINGS_KEY=<64 caracteres hex gerados com segurança>
# Sem essa variável, o servidor cria private/settings.key; guarde-a no backup.
